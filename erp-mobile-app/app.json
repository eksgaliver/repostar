{
  "expo": {
    "name": "S.T.A.R.S",
    "slug": "stars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stars",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stars.raihanrivana"
    },
    "android": {
      "package": "com.stars.raihanrivana",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0b0b0b",
          "defaultChannel": "stars-default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "S.T.A.R.S memakai lokasi Anda untuk memastikan absensi berada di dalam geofence lokasi kerja."
        }
      ],
      "expo-sqlite"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}