# API
PORT=8787

# DeepSeek (optional). Without a key the API answers with a deterministic local echo
# stream so web/mobile can be developed without spending any tokens.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Token guard rails (cheap + fast defaults)
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.3
CHAT_HISTORY_MAX_TURNS=6

# Web
VITE_API_BASE=http://localhost:8787

# Mobile (Expo). Use your LAN IP when running on a physical device.
EXPO_PUBLIC_API_BASE=http://localhost:8787