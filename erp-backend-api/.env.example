# ---------------------------------------------------------------- S.T.A.R.S ERP API
# Copy to .env and fill in real values. Never commit the real file.
NODE_ENV=development
PORT=4000

# PostgreSQL 17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stars_erp

# DragonflyDB / Redis (response cache + FIFO locks)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# Comma separated origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Attendance cycle: 26th -> 25th
CUTOFF_START_DAY=26
CUTOFF_END_DAY=25